        {
          "name": "POST /tareas - Crear tarea válida",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/tareas", "host": ["{{baseUrl}}"], "path": ["tareas"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Implementar autenticación\",\n  \"descripcion\": \"Agregar JWT al proyecto\",\n  \"prioridad\": \"ALTA\",\n  \"idResponsable\": 1,\n  \"fechaLimite\": \"2026-12-31\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retorna id', () => pm.expect(pm.response.json()).to.have.property('id'));",
                  "pm.collectionVariables.set('tareaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
